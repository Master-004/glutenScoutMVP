# Copy to .env if you want to override defaults. docker-compose.yml already
# sets these for the containers, so .env is optional.

# Port the Go web server listens on.
PORT=8080

# Main database (inside Docker Compose the host is "db"; from your machine it's localhost).
DATABASE_URL=postgres://glutenscout:glutenscout@localhost:5432/glutenscout?sslmode=disable

# Separate database used only by `go test` so tests never touch your real data.
TEST_DATABASE_URL=postgres://glutenscout:glutenscout@localhost:5432/glutenscout_test?sslmode=disable
